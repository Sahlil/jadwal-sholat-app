{
  "expo": {
    "name": "jadwal-sholat",
    "slug": "jadwal-sholat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jadwalsholat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sahlilriz.jadwalsholat"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan akses lokasi untuk menyesuaikan jadwal sholat dengan posisi Anda."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "JadwalSholat",
              "label": "Jadwal Sholat",
              "description": "Jadwal sholat hari ini untuk kota pilihan Anda",
              "minWidth": "320dp",
              "minHeight": "70dp",
              "targetCellWidth": 5,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "345a90a9-1999-4c52-9128-7f35213e908d"
      }
    }
  }
}
